{
    "lsp": {
        "oxlint": {
            "initialization_options": {
                "settings": {
                    "run": "onType",
                    "fixKind": "safe_fix",
                    "typeAware": true,
                    "unusedDisableDirectives": "deny"
                }
            }
        },
        "oxfmt": {
            "initialization_options": {
                "settings": { "fmt.configPath": "./vite.config.ts", "run": "onSave" }
            }
        }
    },
    "languages": {
        "CSS": {
            "format_on_save": "on",
            "prettier": { "allowed": false },
            "formatter": {
                "external": {
                    "command": "oxfmt",
                    "arguments": ["--stdin-filepath", "{buffer_path}"]
                }
            }
        },
        "GraphQL": {
            "format_on_save": "on",
            "prettier": { "allowed": false },
            "formatter": {
