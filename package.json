{
    "name": "@klar/website",
    "version": "0.0.1",
    "private": true,
    "description": "Klar website and docs",
    "type": "module",
    "imports": {
        "#lib": "./src/lib/index.js",
        "#lib/*": "./src/lib/*",
        "#/": "./"
    },
    "scripts": {
        "dev": "vp dev",
        "build": "vp build",
        "preview": "vp preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "check:klar": "bun run ./scripts/validateKlar.ts"
    },
    "dependencies": {
        "shiki": "^4.5.0"
    },
    "devDependencies": {
        "@sveltejs/adapter-static": "^4.0.0",
        "@sveltejs/kit": "^3.0.1",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@types/bun": "latest",
        "@typescript/native": "npm:typescript@7",
        "mdsvex": "^0.12.8",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.6",
        "typescript": "^6.0.3",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
        "vite-plus": "1.1.0"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "bun",
            "version": "1.4.2",
            "onFail": "download"
        }
    }
}
