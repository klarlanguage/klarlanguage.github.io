    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#5b6776" }
        },
        {
            "scope": [
                "constant",
                "entity.name.constant",
                "variable.other.constant",
                "variable.other.enummember"
            ],
            "settings": { "foreground": "#c4ceda" }
        },
        { "scope": ["support.constant"], "settings": { "foreground": "#6897cc" } },
        {
            "scope": ["constant.other.character-class.range.regexp"],
            "settings": { "foreground": "#90a9c5" }
        },
        {
            "scope": [
                "constant.character.character-class.regexp",
                "constant.other.character-class.regexp"
            ],
            "settings": { "foreground": "#90a9c5" }
        },
        {
            "scope": ["constant.character.entity"],
            "settings": { "foreground": "#70a9ea" }
        },
        {
            "scope": [
                "constant.character.escape",
                "constant.character",
                "constant.other.placeholder"
            ],
            "settings": { "foreground": "#70a9ea" }
        },
        {
            "scope": ["constant.language.boolean", "constant.language"],
            "settings": { "foreground": "#6897cc" }
        },
        {
            "scope": [
                "constant.numeric",
                "variable.other.enummember",
                "keyword.operator.plus.exponent",
                "keyword.operator.minus.exponent",
                "meta.preprocessor.numeric"
            ],
            "settings": { "foreground": "#6897cc" }
        },
        { "scope": "emphasis", "settings": { "fontStyle": "italic" } },
        {
            "scope": [
                "entity.name.function",
                "support.constant.handlebars",
                "entity.name.operator.custom-literal"
            ],
            "settings": { "foreground": "#8cb6e2" }
        },
        {
            "scope": [
                "keyword.other.doctype",
                "meta.tag.metadata.doctype entity.name.tag",
                "meta.tag.metadata.doctype entity.name.tag.html"
            ],
            "settings": { "foreground": "#7e96b0" }
        },
        { "scope": ["entity.name.tag"], "settings": { "foreground": "#8cb6e2" } },
        {
            "scope": [
                "entity.name.tag.css",
                "entity.name.tag.less",
                "entity.name.tag.html"
            ],
            "settings": { "foreground": "#8cb6e2" }
        },
        {
            "scope": ["entity.name.tag.reference.scss", "entity.name.tag.wildcard"],
            "settings": { "foreground": "#ffffff" }
        },
        { "scope": ["entity.name.tag.yaml"], "settings": { "foreground": "#c7d1dd" } },
        {
            "scope": [
                "entity.name.type",
                "entity.name.type.class",
                "support.class",
                "entity.name.type.interface",
                "variable.defaultLibrary",
                "entity.other.inherited-class"
            ],
            "settings": { "foreground": "#90a9c5" }
        },
        {
            "scope": ["entity.name.type.instance.jsdoc"],
            "settings": { "foreground": "#90a9c5" }
        },
        { "scope": ["entity.name.type.module"], "settings": { "foreground": "#90a9c5" } },
        {
            "scope": "entity.other.attribute-name",
            "settings": { "foreground": "#a1bedc" }
        },
        {
            "scope": ["entity.name.namespace", "entity.name.type.module"],
            "settings": { "foreground": "#a1bedc" }
        },
        {
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name punctuation",
                "source.css entity.other.attribute-name.class",
                "entity.other.attribute-name.parent-selector.css",
                "entity.other.attribute-name.parent.less",
                "entity.other.attribute-name.scss",
                "punctuation.definition.constant.css"
            ],
            "settings": { "foreground": "#90a9c5" }
        },
        {
            "scope": [
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.id punctuation",
                "source.css.less entity.other.attribute-name.id"
            ],
            "settings": { "foreground": "#a3c8f3" }
        },
        {
            "scope": [
                "entity.other.attribute-name.pseudo-element.css",
                "entity.other.attribute-name.pseudo-element punctuation",
                "entity.other.attribute-name.pseudo-element.css"
            ],
            "settings": { "foreground": "#8cb6e2" }
        },
        {
            "scope": "invalid",
            "settings": { "fontStyle": "italic", "foreground": "#fe838f" }
        },
        {
            "scope": [
                "keyword.control",
                "keyword",
                "keyword.other.operator",
                "variable.language.this",
                "entity.name.operator",
                "punctuation.definition.block.tag.jsdoc",
                "storage",
                "storage.modifier",
                "storage.type",
                "keyword.operator.logical.python",
                "variable.language.special",
                "punctuation.definition.keyword",
                "variable.language"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "scope": [
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.relational",
                "keyword.operator.ternary",
                "keyword.operator.assignment"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "scope": ["keyword.operator.or.regexp", "keyword.control.anchor.regexp"],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "scope": "keyword.operator.quantifier.regexp",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "scope": "keyword.other.back-reference.regexp",
            "settings": { "foreground": "#8cb6e2" }
        },
        {
            "scope": ["keyword.other.definition.ini"],
            "settings": { "foreground": "#c7d1dd" }
        },
        { "scope": "keyword.other.unit", "settings": { "foreground": "#7e96b0" } },
        { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
        { "scope": "markup.changed", "settings": { "foreground": "#8cb6e2" } },
        { "scope": "markup.deleted", "settings": { "foreground": "#ffffff" } },
        {
            "scope": "markup.heading",
            "settings": { "fontStyle": "bold", "foreground": "#90a9c5" }
        },
        { "scope": "markup.inline.raw", "settings": { "foreground": "#a3c8f3" } },
        { "scope": "markup.inserted", "settings": { "foreground": "#a3c8f3" } },
        { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
        {
            "scope": [
                "markup.quote.markdown",
                "punctuation.definition.quote.begin.markdown"
            ],
            "settings": { "foreground": "#a3c8f3" }
        },
        { "scope": "markup.strikethrough", "settings": { "fontStyle": "strikethrough" } },
        { "scope": "markup.underline", "settings": { "fontStyle": "underline" } },
        { "scope": "markup.underline.link", "settings": { "foreground": "#728195" } },
        { "scope": "meta.diff.header", "settings": { "foreground": "#569CD6" } },
        {
            "scope": "meta.structure.dictionary.key.python",
            "settings": { "foreground": "#c7d1dd" }
        },
        {
            "scope": ["punctuation", "meta.brace"],
            "settings": { "foreground": "#728195" }
        },
        {
            "scope": [
                "punctuation.definition.string.heredoc",
                "punctuation.definition.heredoc"
            ],
            "settings": { "foreground": "#728195" }
        },
        {
            "scope": "punctuation.definition.list.begin.markdown",
            "settings": { "foreground": "#6897cc" }
        },
        {
            "scope": ["punctuation.definition.tag"],
            "settings": { "foreground": "#728195" }
        },
        {
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#728195" }
        },
        {
            "scope": [
                "punctuation.section.embedded.begin.php",
                "punctuation.section.embedded.end.php"
            ],
            "settings": { "foreground": "#ffffff" }
        },
        {
            "scope": [
                "source.css entity.other.attribute-name.pseudo-class",
                "source.css entity.other.attribute-name.pseudo-class punctuation"
            ],
            "settings": { "foreground": "#7e96b0" }
        },
        {
            "scope": [
                "string",
                "meta.embedded.assembly",
                "meta.preprocessor.string",
                "string.tag",
                "string.value",
                "punctuation.definition.string"
            ],
            "settings": { "foreground": "#a3c8f3" }
        },
        { "scope": "string.regexp", "settings": { "foreground": "#a3c8f3" } },
        {
            "scope": "string.regexp constant.character.escape",
            "settings": { "foreground": "#a3c8f3" }
        },
        {
            "scope": "string.regexp meta.assertion",
            "settings": { "foreground": "#ffffff" }
        },
        {
            "scope": "string.regexp punctuation.definition.string",
            "settings": { "foreground": "#728195" }
        },
        { "scope": "string.tag", "settings": { "foreground": "#a3c8f3" } },
        { "scope": "strong", "settings": { "fontStyle": "bold" } },
        { "scope": ["support.class.component"], "settings": { "foreground": "#90a9c5" } },
